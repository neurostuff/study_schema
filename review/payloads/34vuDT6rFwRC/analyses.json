   },
   "definition": {
    "extraction_status": "extracted",
    "value": "Decoding the direction of moving auditory stimuli from multivariate fMRI activation patterns in the dorsal occipito-temporal ROI",
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "quotes": [
        "We then trained a logistic regression classifier and evaluated its performance by predicting stimulus direction on each fMRI volume in the independent test data, using an eight-fold crossvalidation."
       ]
      }
     ]
    }
   },
   "prespecification": {
    "extraction_status": "not_reported",
    "evidence": {
     "status": "not_applicable"
    }
   },
   "interpretations": {
    "extraction_status": "extracted",
    "value": [
     "Information about the direction of auditory motion is present in dorsal occipito-temporal responses of blind humans.",
     "The direction in which an auditory stimulus is moving can be decoded from ensemble responses in dorsal occipito-temporal cortex."
    ],
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "quotes": [
        "We therefore conclude that information about the direction of auditory motion is present in dorsal occipito-temporal responses of blind humans, which goes beyond previous demonstrations of overall motion-related activation in this region.; Using multivariate pattern classification, we have shown that the direction in which an auditory stimulus is moving can be decoded from ensemble responses in dorsal occipito-temporal cortex."
       ]
      }
     ]
    }
   },
