 "study": {
  "description": {
   "extraction_status": "extracted",
   "value": "Cross-sectional task-based fMRI study examining visuospatial dysfunction and brain activation in female patients with rheumatoid arthritis, including relationships between left precuneus activation, mental rotation performance, and disease activity.",
   "value_source": "reported",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "quotes": [
       "To identify the potential diagnostic biomarkers of rheumatoid arthritis (RA) and assess the relation between visuospatial dysfunction and disease activity in RA patients using mental rotation task (MRT)-based functional magnetic resonance imaging (fMRI)."
      ]
     }
    ]
   }
  },
  "design": {
   "description": {
