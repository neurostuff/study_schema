    "evidence": {
     "status": "present",
     "sets": [
      {
       "quotes": [
        "To investigate developmental differences in neural recruitment during self-processing, in particular interaction effects between age group, evaluative perspective, and domain, a 2 (age group: adults/adolescents) × 4 (evaluative perspective: direct self/direct other/reflected self/malleability) × 3 (domain: academic/physical/social) whole-brain, repeated-measures ANOVA was conducted, with age group as the between-subjects factor and evaluative perspective and domain as the within-subjects factors."
       ]
      }
     ]
    }
   },
