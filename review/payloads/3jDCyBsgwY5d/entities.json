 "preprocessings": [
  {
   "local_id": "prep-fmri",
   "description": {
    "extraction_status": "extracted",
    "value": "Functional MRI data were temporally aligned, motion corrected, spatially smoothed, intensity normalized, modeled with multiple regression, and warped to MNI space.",
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "quotes": [
        "First, all acquired slices were temporally aligned within each volume (  3dTshift  ), corrected for head motion (  3dvolreg  ), spatially smoothed (  3dmerge  ) with a 4 mm FWHM Gaussian filter, and normalized by dividing, within each voxel, every time point by the mean of the time series. A multiple regression analysis was then performed on normalized runs (  3dDeconvolve  ), to identify stimulus-related BOLD patterns. ... then, the obtained deformation field was used to warp functional maps for each task type."
       ]
      }
     ]
    }
   },
