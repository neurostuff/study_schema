    "title": {
      "extraction_status": "extracted",
      "value": "Language impairment in Parkinson’s disease: fMRI study of sentence reading comprehension",
      "value_source": "reported",
      "evidence": {
        "status": "not_found"
      }
    },
    "description": {
      "extraction_status": "extracted",
      "value": "Task fMRI study comparing comprehension of syntactically complex Slovak sentences (canonical vs. non-canonical word order) between non-demented patients with Parkinson's disease and healthy controls, and using psychophysiological interaction analysis of striatal connectivity to identify the neural underpinnings of the comprehension deficit.",
      "value_source": "generated",
      "evidence": {
        "status": "present",
        "sets": [
          {
            "quotes": [
              "Our aim was to describe specific alterations in the comprehension of syntactically complex sentences in PD as compared to HC and to identify the neural underpinnings of these deficits using a functional connectivity analysis of the striatum."
            ]
          }
        ]
      }
    },
    "design": {
      "extraction_status": "extracted",
      "value": "Cross-sectional case-control task fMRI study: PwPD and HC read sentences during fMRI (Test of sentence comprehension adjusted for fMRI, with canonical, non-canonical and control conditions), with between-group comparison of accuracy and seed-based psychophysiological interaction (PPI) connectivity analysis of the striatum.",
      "value_source": "generated",
      "evidence": {
        "status": "present",
        "sets": [
          {
            "quotes": [
              "we analyzed the performance of a language-specific Slovak version of the test of sentence comprehension (ToSC) adjusted for fMRI",
              "A task-dependent functional connectivity analysis from the striatum was studied using the psychophysiological interaction method (PPI)"
            ]
          }
        ]
      }
    },
