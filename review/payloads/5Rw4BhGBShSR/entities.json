 "tasks": [
  {
   "local_id": "task_audiovisual_sentence_comprehension",
   "name": {
    "extraction_status": "extracted",
    "value": "audiovisual sentence comprehension",
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "quotes": [
        "Participants in a functional MRI experiment watched and listened to videos of spoken sentences in which the auditory intelligibility and talker gaze direction were manipulated factorially."
       ]
      }
     ]
    }
   },
   "description": {
    "extraction_status": "extracted",
    "value": "Participants watched and listened to videos of spoken English sentences while auditory intelligibility and talker gaze direction were manipulated factorially; they performed a catch-trial vigilance task.",
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "quotes": [
        "The experiment followed a 2×4 design with factors Gaze Direction (Averted, Downward, Direct, None) and Channels (2, 3). A sparse-sampling routine ( Edmister et al., 1999 ,  Hall et al., 1999 ) was employed, in which the audiovisual stimuli were presented in the quiet period between scans. In total, there were 30 trials from each of these eight conditions, organized into miniblocks of 16 randomized trials containing 2 examples from each condition. After each miniblock of 16 trials, a seventeenth “catch” trial contained a 1-back vigilance task, in which the participant was probed with an onscreen text keyword and asked to indicate (via keypress on the in-scanner button box) whether this word was contained in the most recently played sentence."
       ]
      }
     ]
    }
   },
