  "description": {
   "extraction_status": "extracted",
   "value": "The study investigated whether the anterior paracingulate cortex is involved in understanding other people's intentions generally or specifically in understanding intentions during social interaction, including predicting future intentional social interaction.",
   "value_source": "generated",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "spans": [
       {
        "text": "In two separate fMRI experiments, we demonstrated that the anterior PCC is not necessarily involved in the understanding of other people's intentions per se, but primarily in the understanding of the intentions of people involved in social interaction."
       },
       {
        "text": "This result suggests that the anterior PCC is also involved in our ability to predict future intentional social interaction, based on an isolated agent's behavior."
       }
      ]
     }
    ]
   }
  },
  "design": {
   "extraction_status": "extracted",
   "value": "Two separate fMRI experiments examined intentions of persons involved in social interactions and intentions of an isolated person.",
   "value_source": "generated",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "spans": [
       {
        "text": "To date, neuroimaging studies have not properly distinguished between intentions of persons involved in social interactions and intentions of an isolated person."
       },
       {
        "text": "In two separate fMRI experiments, we demonstrated that the anterior PCC is not necessarily involved in the understanding of other people's intentions per se, but primarily in the understanding of the intentions of people involved in social interaction."
       }
      ]
     }
    ]
   }
