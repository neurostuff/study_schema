  },
  "design": {
   "extraction_status": "extracted",
   "value": "A retrospective cross-sectional case-control voxel-based morphometry study compared gray-matter concentration between nine FTD patients and 26 healthy controls using high-resolution 3D T1-weighted MRI. Age was included as a covariate, with whole-brain statistical inference and a small-volume correction analysis for the periaqueductal gray.",
   "value_source": "generated"
