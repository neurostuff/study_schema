    "hrf_model": {
     "extraction_status": "extracted",
     "value": "reconvolved with hemodynamic function",
     "value_source": "reported"
    },
    "model_settings": {
     "extraction_status": "extracted",
     "value": "Three independent PPI analyses used 10-mm spherical seed regions centered in vmPFC at MNI coordinates X = \u22126, Y = 39, Z = \u22128, frontal cortex at X = \u221245, Y = 21, Z = 0, and parietal cortex at X = \u221236, Y = \u221239, Z = 45. The seed-region BOLD signal was deconvolved, interacted with the trial-wise amount-of-bias regressor in the neural domain, and reconvolved. The design matrix included the GLM design plus the raw seed time course and the PPI regressor.",
     "value_source": "reported"
    },
    "level": {
