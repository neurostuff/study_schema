    "local_id": "model_reinforcement_learning",
    "model_type": {
     "extraction_status": "extracted",
     "value": "two Q-learning reinforcement-learning models",
     "value_source": "reported"
    },
    "hrf_model": {
     "extraction_status": "not_reported"
    },
    "model_settings": {
     "extraction_status": "extracted",
     "value": "A logit function generated the probability of binary choices from the subjective value difference between motion directions and the current motion stimulus. One model updated action values using context-dependent RPE, whereas the other updated action values regardless of context. Free parameters included choice sensitivity to value difference and motion stimulus and a learning rate. Initial action values were initialized with participants' initial bias from the practice session when present.",
     "value_source": "reported"
    },
    "level": {
     "extraction_status": "extracted",
     "value": "participant-level model",
     "value_source": "generated"
    },
    "estimator": {
     "extraction_status": "extracted",
     "value": "maximum likelihood; free parameters were fit by minimizing the negative log likelihood with a non-linear optimization function",
     "value_source": "reported"
    },
    "software": [
