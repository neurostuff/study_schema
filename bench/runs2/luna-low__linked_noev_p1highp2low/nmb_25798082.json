      "extraction_status": "extracted",
      "value": "Scipy toolbox for python, fmin optimization function",
      "value_source": "reported"
     }
    ]
   },
   {
    "local_id": "model_fmri_glm",
    "model_type": {
     "extraction_status": "extracted",
     "value": "multi-stage general linear model (GLM)",
     "value_source": "reported"
    },
    "hrf_model": {
     "extraction_status": "extracted",
     "value": "double-gamma hemodynamic response function with temporal derivatives",
     "value_source": "reported"
    },
    "model_settings": {
     "extraction_status": "extracted",
     "value": "The first-level model was estimated separately for each run and participant. The five runs were combined within participant using a fixed-effects model, and the group level used the FLAME 1 mixed-effects model. Parametric regressors were absolute coherence, trial-wise amount of bias, and reward prediction error from both learning models. Nuisance regressors modeled trial-evoked activity, reaction time, motion correction parameters, FD, DVARS, and scrubbed time points. The RT regressor was orthogonalized relative to trial-evoked activity; other regressors were not orthogonalized.",
     "value_source": "reported"
    },
    "level": {
     "extraction_status": "extracted",
     "value": "first-level, within-participant fixed-effects, and group-level mixed-effects",
     "value_source": "reported"
    },
    "estimator": {
     "extraction_status": "extracted",
     "value": "FSL FEAT multi-stage estimation; FLAME 1 mixed-effects model at group level",
     "value_source": "reported"
    },
    "software": [
