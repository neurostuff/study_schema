  "preprocessings": [
   {
    "local_id": "prep_fmri",
    "description": {
     "extraction_status": "extracted",
     "value": "FMRI data preprocessing was carried out using FSL. Image time series were aligned with MCFLIRT, motion and artifact measures were computed, skulls were removed, images were smoothed, intensity was normalized, high-pass filtered, and functional and structural images were registered to structural and MNI space.",
     "value_source": "reported"
    },
    "software": [
     {
      "extraction_status": "extracted",
      "value": "FSL Version 5.0.1 (FMRIB's Software Library)",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "MCFLIRT",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "BET",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "FreeSurfer",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "FLIRT",
      "value_source": "reported"
     }
    ],
    "steps": [
     {
      "extraction_status": "extracted",
      "value": "Align all image time series with MCFLIRT.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Use motion parameters to compute frame-wise displacement (FD) and temporal derivative of the root mean square variance over voxels (DVARS).",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Identify bad time points using FD > 0.5 and DVARS > 0.5.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Remove the skull from functional images with the brain extraction tool (BET).",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Remove the skull from structural images using FreeSurfer.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Apply spatial smoothing using a Gaussian kernel of FWHM 5 mm.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Normalize grand-mean intensity over the entire 4D dataset by a single multiplicative factor.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Apply high-pass temporal filtering using Gaussian-weighted least-squares straight line fitting with sigma = 50.0 s.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Apply the same high-pass filter to the design matrix for fMRI time-series analysis.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Register all functional images to the high-resolution structural image using Boundary-Based Registration (BBR).",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Register the high-resolution structural image to the MNI-152 2 mm template using the FLIRT linear registration tool with 12 degrees of freedom.",
      "value_source": "reported"
     }
    ]
   }
  ],
