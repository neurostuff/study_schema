  "description": {
   "extraction_status": "extracted",
   "value": "The study tested whether evidence accumulation during perceptual decision making could be detected in BOLD fMRI by slowing decisions with penalties for incorrect responses, separating detection-related boxcar activity from integration-related ramping activity, and comparing the motion discrimination task with a matched control task.",
   "value_source": "generated"
  },
  "design": {
   "extraction_status": "extracted",
   "value": "Participants performed a random dot motion discrimination task with penalties for incorrect responses that prolonged decision times. BOLD activity was modeled with up-ramp and down-ramp regressors, and compared with a control task containing matched random-dot viewing times and motor responses but no evidence accumulation from coherent motion.",
   "value_source": "reported"
  },
