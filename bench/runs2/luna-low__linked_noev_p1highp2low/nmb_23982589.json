    },
    "instructions": {
     "extraction_status": "extracted",
     "value": "Participants were instructed to attend covertly to the moving dots and monitor for periods of motion coherence, or to attend to the central spot and monitor for color changes. They were told that the signal would occasionally be below their perceptual threshold and that in these instances they should make their best guess as to the direction of motion immediately prior to stimulus offset. They were reminded to maintain fixation centrally and avoid blinking during stimulus presentations.",
     "value_source": "reported"
    },
    "stimuli": {
     "extraction_status": "extracted",
     "value": "Digital movies created with Matlab (Version 7.9) consisted of a 0.4\u00b0 central fixation spot and 400 sparse gray background dots on a black background. The fixation spot alternated between green and yellow at 0.2 Hz, while the background dots formed random-dot kinematograms with 0, 15, or 30% coherent motion.",
     "value_source": "reported"
    },
