     "value_source": "reported"
    },
    "task_description": {
     "extraction_status": "extracted",
     "value": "Participants were instructed to proactively prepare to use a specific emotion-regulation strategy, namely suppression, reappraisal or appraisal, knowing that a negative, high-arousing image would appear after the preparation period. Each trial began with a fixation cross, followed by a cue word, a blank preparation interval, a 10-s negative image target, a success rating screen and an 8-s RELAX screen.",
     "value_source": "reported"
    },
    "conditions": [
     "cond_cue_suppression",
     "cond_cue_reappraisal",
     "cond_cue_appraisal",
     "cond_target_suppression",
     "cond_target_reappraisal",
     "cond_target_appraisal"
    ],
    "design_type": {
     "extraction_status": "extracted",
     "value": "event-related",
     "value_source": "reported"
    },
    "acquisitions": [
     "acq_functional_mri"
    ],
    "presentation_software": {
     "extraction_status": "not_reported"
    },
    "instructions": {
     "extraction_status": "extracted",
     "value": "For suppression, participants were trained to suppress displaying their feelings elicited by the picture and not to show what they were feeling on an outward level. For reappraisal, they were trained to reinterpret the situational event depicted by changing the emotions, actions and outcomes of individuals depicted in the situational context and to generate an alternative interpretation that explained apparently negative events in a less negative way. For appraisal, they were instructed to simply look at the pictures, feel their natural feelings and not change anything.",
     "value_source": "reported"
    },
    "stimuli": {
     "extraction_status": "extracted",
     "value": "63 negative pictures from the International Affective Picture System, with mean arousal values >6 and mean valence ratings <4 based on normative ratings of female participants. Each image was shown only once for a given participant.",
     "value_source": "reported"
    },
