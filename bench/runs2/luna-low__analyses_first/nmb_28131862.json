     "evidence": {
      "status": "present",
      "sets": [
       {
        "spans": [
         {
          "text": "Functional images were first aligned to correct for head movement during the scan. Slice timing correction was then performed using sine interpolation. Images were subsequently normalized to Montreal Neurological Institute coordinates (the TT_N27 template) and resampled at 3 \u00d7 3 x 3 mm3 resolution. A Gaussian smoothing kernel of 4 mm full-width at half-maximum (FWHM) was applied to improve comparison across subjects, and finally, all time series were scaled to have a mean signal value of 100."
         }
        ]
       }
      ]
     }
    }
