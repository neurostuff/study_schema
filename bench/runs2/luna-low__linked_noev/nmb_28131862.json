  "description": {
   "extraction_status": "extracted",
   "value": "The study tested whether evidence accumulation during slow perceptual decisions could be observed in BOLD fMRI by imposing penalties for incorrect responses, separating detection from integration with up-ramp and down-ramp regressors, and comparing a motion discrimination task with a matched control task.",
   "value_source": "generated"
  },
  "design": {
   "extraction_status": "extracted",
   "value": "Participants performed a random dot motion discrimination task and a control task with matched visual input, dot-motion viewing times, and manual responses but no evidence accumulation for dot motion. Incorrect responses were penalized to prolong decisions, and fMRI data were analyzed with GLM up-ramp and down-ramp regressors and voxel-wise repeated-measures ANOVA.",
   "value_source": "generated"
  },
