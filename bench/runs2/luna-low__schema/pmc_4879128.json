    "sets": [
     {
      "spans": [
       {
        "text": "Participants MRI data were obtained and analyzed from 28 young adults between the ages of 25 and 27 years (mean = 25.70 \u00b1 0.67) who were recruited from a large, epidemiological study of Puerto Ricans in the South Bronx, New York and San Juan, Puerto Rico (Bird et al., 2006 )."
       }
      ]
     }
    ]
   }
