  "description": {
   "extraction_status": "extracted",
   "value": "The study investigated cue-reactivity-related brain activation and craving in treatment-seeking problem gamblers, heavy smokers, and healthy controls using an event-related fMRI picture paradigm.",
   "value_source": "generated",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "spans": [
       {
        "text": "In this neuroimaging study, cue reactivity in problem gamblers (PRG) was compared with cue reactivity in heavy smokers (HSM) and healthy controls (HC)."
       }
      ]
     },
     {
      "spans": [
       {
        "text": "We employed an event-related picture paradigm"
       }
      ]
     }
    ]
   }
  },
  "design": {
   "extraction_status": "extracted",
   "value": "An event-related fMRI cue reactivity paradigm with gambling, smoking-related, neutral, and low-level baseline pictures was used, with between-group and craving-correlation analyses.",
   "value_source": "generated",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "spans": [
       {
        "text": "A functional magnetic resonance imaging event-related cue reactivity paradigm, consisting of gambling, smoking-related and neutral pictures, was employed in 17 treatment-seeking non-smoking PRG, 18 non-gambling HSM, and 17 non-gambling and non-smoking HC."
       }
      ]
     },
     {
      "spans": [
       {
        "text": "Thirty gambling pictures, 30 smoking-related pictures, 30 neutral pictures and 30 low-level baseline pictures were presented randomly"
       }
      ]
     }
    ]
   }
  },
