  "description": {
   "extraction_status": "extracted",
   "value": "The study examined whether anodal tDCS over the left inferior frontal gyrus, combined with language therapy, altered resting-state functional connectivity and whether connectivity changes were associated with improvements in written naming in people with primary progressive aphasia.",
   "value_source": "generated",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "spans": [
       {
        "text": "In the present study, we examined changes in functional connectivity in the language network, as identified in task-based fMRI studies of spoken and written word production, to determine whether functional connectivity change is a mechanism for tDCS effects in PPA."
       }
      ]
     }
    ]
   }
  },
  "design": {
   "extraction_status": "extracted",
   "value": "A double-blinded, within-subject crossover clinical trial was analyzed using only the first phase, yielding a between-subject comparison of participants initially receiving tDCS versus sham, both paired with speech-language therapy.",
