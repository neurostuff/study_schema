  "description": {
   "extraction_status": "extracted",
   "value": "The study examined whether motivational dispositions differ between depressed patients and healthy controls and whether BIS/BAS scores modulate neural responses during cognitive reappraisal.",
   "value_source": "generated",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "spans": [
       {
        "text": "Second, to test the hypothesis that motivation dispositions differentially modulated reappraisal-related brain responses in two groups, we conducted a voxel-wise analysis of covariance (ANCOVA) with group, emotion and ER as between-subject factors and BIS/BAS subscale scores as covariates."
       }
      ]
     }
    ]
   }
  },
  "design": {
   "extraction_status": "extracted",
   "value": "A block-design fMRI study compared drug-free patients with major depressive disorder and healthy controls during attend, detach, and immerse emotion-regulation conditions, with BIS/BAS motivation scores entered as covariates and predictors.",
   "value_source": "generated",
   "evidence": {
    "status": "present",
    "sets": [
     {
      "spans": [
       {
        "text": "The task was performed in three consecutive blocks (\u201cATTEND,\u201d \u201cDETACH,\u201d and \u201cIMMERSE\u201d). Block design was utilized to avoid potential task-switching effects that might obscure differences between regulation and passive viewing conditions."
       }
      ]
     }
    ]
   }
  },
