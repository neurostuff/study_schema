    "model_settings": {
     "extraction_status": "extracted",
     "value": "Group SPM contrast maps were created to determine the mean suprathreshold activation for the low-calorie food, high-calorie food, and utensil conditions relative to the control conditions. A conjunction analysis tested regions activated during both high- and low-calorie conditions. Linear contrasts between low-calorie and high-calorie conditions used masks created during the initial group maps. Group SPMs and all contrasts were thresholded at P < .005 uncorrected with a minimum cluster size of 20 contiguous voxels; the high-calorie condition was also evaluated post hoc at P < .0005 uncorrected.",
     "value_source": "reported"
    },
    "level": {
