     "extraction_status": "extracted",
     "value": "Presentation (Version 14.1, Neurobehavioral Systems, USA)",
     "value_source": "reported"
    },
    "instructions": {
     "extraction_status": "extracted",
     "value": "In the Increase condition, subjects were asked to engage themselves with the depicted situation and increase their sense of subjective closeness to the displayed events. In the Decrease condition, subjects were instructed to reduce the intensity of the negative emotion by distancing themselves from the image and becoming a detached observer. In the Look conditions, subjects were asked to view the stimuli attentively and allow themselves to experience any emotional responses without trying to manipulate them. Subjects received a training session to practice the emotion reappraisal strategies before scanning.",
     "value_source": "reported"
    },
    "stimuli": {
     "extraction_status": "extracted",
     "value": "126 aversive and 42 neutral pictures from the International Affective Picture System (IAPS), presented centrally on a black background. Images were displayed on dual display goggles with an 800 \u00d7 600 pixel display subtending 32\u00b0 \u00d7 24\u00b0 visual angle; pictures subtended 24\u00b0 \u00d7 18\u00b0 visual angle.",
     "value_source": "reported"
    },
