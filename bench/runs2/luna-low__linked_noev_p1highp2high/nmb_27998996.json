      "value": "down-sampled offline to 10 Hz",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "decomposed skin-conductance data into continuous tonic and phasic activity",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "averaged across trials within each condition applying an 8 s time window",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "only runs including more than 10% SCRs exceeding the 0.01 \u00b5S criterion were used for analysis",
