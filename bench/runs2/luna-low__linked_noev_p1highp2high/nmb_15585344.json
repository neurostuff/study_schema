    "steps": [
     {
      "extraction_status": "extracted",
      "value": "Removing the voxels below the cerebellum with MRIcro.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Creation of a customized template of the whole brain by normalization of control images to the T1-stereotactic template of SPM99 using a 12-parameter affine transformation followed by averaging.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Segmentation of images into gray matter, white matter, and CSF with a modified mixture model cluster algorithm.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Creation of a customized stereotactic gray matter template by averaging extracted gray matter from controls.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Normalization of case and control gray matter onto the gray matter template with affine and non-linear transformations, medium regularization, re-slicing 2 mm \u00d72 mm \u00d72 mm, and no masking.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Visual inspection of the resulting images one by one to exclude gross segmentation errors.",
      "value_source": "reported"
     },
     {
      "extraction_status": "extracted",
      "value": "Smoothing of the normalized gray matter images with an isotropic Gaussian filter of 8 mm.",
      "value_source": "reported"
     }
    ]
   }
