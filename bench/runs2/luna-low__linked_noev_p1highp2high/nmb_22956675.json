     "extraction_status": "not_reported"
    },
    "instructions": {
     "extraction_status": "extracted",
     "value": "For suppression, participants were trained to suppress displaying their feelings elicited by the picture and not to show what they were feeling. For reappraisal, they were trained to reinterpret the situational event by generating an alternative, less negative interpretation. For appraisal, they were instructed to simply look at the pictures, feel their natural feelings and not change anything. Participants were also instructed to prepare for the relevant strategy during the cue-offset period.",
     "value_source": "reported"
    },
    "stimuli": {
     "extraction_status": "extracted",
     "value": "The stimulus set consisted of 63 negative pictures from the International Affective Picture System, with mean arousal values greater than 6 and mean valence ratings lower than 4 based on normative ratings of female participants. Each image was shown only once for a given participant.",
     "value_source": "reported"
    },
    "task_performance_measures": [
