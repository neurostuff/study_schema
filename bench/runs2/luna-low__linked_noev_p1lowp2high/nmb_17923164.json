  "preprocessings": [
   {
    "local_id": "prep_vbm",
    "description": {
     "extraction_status": "extracted",
     "value": "An optimized study-specific template set was created. Scans were spatially normalized to the customized template, smoothed with an 8-mm FWHM smoothing kernel, averaged to create a customized template, segmented into gray matter and white matter using customized prior probability maps, modulated to correct for volume changes during spatial normalization, and finally smoothed using a 12-mm FWHM Gaussian kernel. For the amygdala and hippocampus, 4-mm FWHM smoothing was performed.",
