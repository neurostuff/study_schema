  "description": {
   "extraction_status": "extracted",
   "value": "The study investigated whether perceptual guesses under zero visibility share neural representations with internally generated free decisions, using fMRI-based multivariate pattern classification.",
   "value_source": "generated"
  },
  "design": {
   "extraction_status": "extracted",
   "value": "An event-related fMRI study in which participants made category choices about pianos and chairs using three different conditions: high-visibility perceptual choices, zero-visibility perceptual guesses, and free choices. Searchlight decoding and cross-condition classification were used to identify shared choice-predictive activation patterns.",
   "value_source": "reported"
  },
