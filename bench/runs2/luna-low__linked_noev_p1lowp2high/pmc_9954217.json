  "description": {
   "extraction_status": "extracted",
   "value": "The study investigated altered brain activation during cognitive control in individuals with methamphetamine dependence compared with healthy controls using an fMRI Stroop task, and examined associations between activation, performance, impulsivity, and methamphetamine-use characteristics.",
   "value_source": "generated"
  },
  "design": {
   "extraction_status": "extracted",
   "value": "A cross-sectional between-groups fMRI study with 18 individuals with methamphetamine dependence and 21 healthy controls performing a two-condition manual Stroop task during MRI. The fMRI analysis used a group-by-condition ANCOVA with age as a covariate, followed by correlational analyses.",
   "value_source": "generated"
  },
