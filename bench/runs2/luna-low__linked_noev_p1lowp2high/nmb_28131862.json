  "description": {
   "extraction_status": "extracted",
   "value": "The study tested whether evidence accumulation during slow perceptual decision making could be detected in BOLD fMRI by imposing penalties for incorrect responses, distinguishing ramping integration activity from boxcar-like detection activity, and comparing a motion discrimination task with a matched control task.",
   "value_source": "generated"
  },
  "design": {
   "extraction_status": "extracted",
   "value": "Participants performed a random dot motion discrimination task with penalties for incorrect responses, alongside a control task involving randomly moving dots followed by an arrow cue. BOLD responses were modeled with up-ramp and down-ramp regressors and compared between tasks.",
   "value_source": "generated"
  },
