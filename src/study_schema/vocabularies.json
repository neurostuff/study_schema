    {
      "name": "condition_atom",
      "title": "Condition atoms",
      "legacy_vocabularies": ["astra condition atom: {axis}", "astra condition atom"],
      "release": "ns-pond-47e8470",
      "download": null,
      "sources": [
        {
          "repository": "neurostuff/ns-pond-ingestion-workflow",
          "commit": "47e84703ba6b89949c7414b86588e1c6b2c0421d",
          "path": "ingestion_workflow/normalization/taskcat/conditions.py",
          "sha256": "86a8500f31c2478723a65140de44f4902d9e277966e2b41e469cb44e8aedb332",
          "role": "the rules: `ATOMS`, and the family- and task-dependent rewrites in `normalize_condition_ctx`"
        }
      ],
      "id_form": "<axis>:<value>, for example congruency:incongruent",
      "hierarchy": {
        "kind": "prefix",
        "separator": ":",
        "parent_vocabulary": null,
        "description": "The axis, the id's text before the first ':'."
      },
      "values": null,
      "notes": "The legacy entries carry the axis in the vocabulary string and only the value in `value` (`astra condition atom: congruency` / `incongruent`); `astra condition atom` without an axis appears only on unmapped entries. Under this name the id is `<axis>:<value>`, the form the rules themselves produce. The set is open-ended: the rewrites add atoms that `ATOMS` does not list (congruency:neutral, and level:* moved onto another axis), so no value list is pinned."
    },
